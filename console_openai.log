{'type': 'messages', 'ns': ('tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0',), 'data': (AIMessageChunk(content='\n\n# 司马迁生平研究报告\n\n---\n\n## 一、出生背景与家庭环境\n\n### 1. 生卒年代与出身\n\n司马迁（约公元前145年—公元前86年），字子长，夏阳（今陕西韩城', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e015a-67f8-7092-85a2-ff32c601bb77', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 14, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0|model:db67483f-79c5-2661-00be-ccee17f96452', 'checkpoint_ns': 'tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})}

