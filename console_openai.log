{'type': 'messages', 'ns': ('tools:eb503023-f409-43b2-066e-29b3f540c20b',), 'data': (AIMessageChunk(content='在楚汉相争的后半段表现得尤为明显：他能够在野战中击败任何对手，却无法攻破荥阳的防线，无法切断刘邦的补给线，无法在持久', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e015a-1574-7c10-b5e3-635e4e073ee2', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 5, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:eb503023-f409-43b2-066e-29b3f540c20b|model:78702b7c-1596-fe34-9d07-bde32ac35cd5', 'checkpoint_ns': 'tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})}

