{'type': 'messages', 'ns': ('tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0',), 'data': (AIMessageChunk(content='武帝对李陵投降之事极为震怒，满朝文武皆顺承上意，斥责李陵叛降。\n\n司马迁与李', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e015c-b4f7-7d51-828f-a6a8e530b2da', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 17, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0|model:8c0fc49c-874c-1f20-c343-872630c5d324', 'checkpoint_ns': 'tools:2cbc0d99-dffb-ae77-ae8e-c53b657bd4e0', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})}

