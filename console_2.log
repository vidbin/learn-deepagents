tuple 2 (AIMessageChunk(content='YSTALS-Kyber**（密钥封装机制）和**CRYSTALS-Dilithium**（数字签名）等算法。这些算法基于格密码学、编码理论等数学难题，即使量子计算机也无法在有效时间内破解。\n\n中国也在', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0068-98cc-7163-ad92-06be987abb55', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 8, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2|model:ca3e24b0-c0d5-b9b6-59ae-72a6ca3730a0', 'checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

