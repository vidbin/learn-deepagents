tuple 2 (AIMessageChunk(content='积极推进后量子密码学的研究和标准化工作。中国的密码学研究机构和企业正在评估和研发适合中国技术体系的后量子密码算法，并参与相关国际标准的制定。\n\n**"现在收集，以后解密', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0068-98cc-7163-ad92-06be987abb55', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 8, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2|model:ca3e24b0-c0d5-b9b6-59ae-72a6ca3730a0', 'checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

