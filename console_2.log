tuple 2 (AIMessageChunk(content='。\n\n为应对这一威胁，**后量子密码学**（Post-Quantum Cryptography, PQC）的研究和标准化正在加速推进。美国国家标准与技术研究院（NIST）于2024年正式发布了后量子密码学标准，包括**CR', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0068-98cc-7163-ad92-06be987abb55', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 8, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2|model:ca3e24b0-c0d5-b9b6-59ae-72a6ca3730a0', 'checkpoint_ns': 'tools:e554daa6-5e41-a2d9-202e-ee453a829dd2', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

