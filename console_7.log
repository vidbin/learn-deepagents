tuple 2 (AIMessageChunk(content='帝国；又在随后四年中，因战略失误、用人失当和性格缺陷，由盛转衰，最终在乌江之畔完成了其悲', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0148-dbab-77e2-88c6-644fba8bc05c', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 5, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:4ebc2504-295e-61ae-fe09-23fd7fb3e64e|model:6ab14584-9f0a-d027-fcd5-2f043334dfe1', 'checkpoint_ns': 'tools:778df5cd-309c-402e-7e86-e7dc2db3c268', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

