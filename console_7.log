tuple 2 (AIMessageChunk(content='不知其所往。每念斯耻，汗未尝不发背沾衣也。"\n\n### 宫刑执行时间\n约在天汉三年（前98年）左右。\n\n', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e014a-447f-7f23-9dec-0b5369ce3b83', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 11, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:778df5cd-309c-402e-7e86-e7dc2db3c268|model:76f13e85-cb69-b21b-ec3d-f9a0c47054a4', 'checkpoint_ns': 'tools:778df5cd-309c-402e-7e86-e7dc2db3c268', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

