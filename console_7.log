tuple 2 (AIMessageChunk(content='未获封赏者的不满（如田荣、陈余、彭越等），为日后的诸侯叛乱埋下了祸根。\n\n---\n\n## 四', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0148-dbab-77e2-88c6-644fba8bc05c', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 5, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:4ebc2504-295e-61ae-fe09-23fd7fb3e64e|model:6ab14584-9f0a-d027-fcd5-2f043334dfe1', 'checkpoint_ns': 'tools:778df5cd-309c-402e-7e86-e7dc2db3c268', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

messages ('tools:4ebc2504-295e-61ae-fe09-23fd7fb3e64e',) tools:4ebc2504-295e-61ae-fe09-23fd7fb3e64e True
tuple 2 (AIMessageChunk(content='、楚汉相争的过程\n\n### 1. 战争的导火索\n\n公元前206年分封完毕后不到数月，原燕王韩广的部下臧荼驱逐韩广，自立为燕王；田荣因未获封赏，杀齐王田都，自立为齐王；陈余驱逐常山王张耳，迎立赵歇为赵王。项羽疲于应付四面开花的叛乱，无暇专注于对刘邦的战略。\n\n刘邦在汉中拜韩信为大将，“明修栈道，暗度陈仓”，迅速还定三', additional_kwargs={}, response_metadata={'model_provider': 'openai'}, id='lc_run--019e0148-dbab-77e2-88c6-644fba8bc05c', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 5, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:4ebc2504-295e-61ae-fe09-23fd7fb3e64e|model:6ab14584-9f0a-d027-fcd5-2f043334dfe1', 'checkpoint_ns': 'tools:778df5cd-309c-402e-7e86-e7dc2db3c268', 'ls_provider': 'openai', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None})

