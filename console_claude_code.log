{'type': 'messages', 'ns': ('tools:8dc57837-ad49-ac67-0914-8c2cccfeddf2',), 'data': (AIMessageChunk(content=[{'text': ' 项羽率军东归。\n\n**撕毁和约**：刘邦在张良、陈平的劝说下，撕毁和约，追击东归的楚军。\n\n---\n\n## 五、乌江自刎与悲剧结局\n\n### 1', 'type': 'text', 'index': 1}], additional_kwargs={}, response_metadata={'model_provider': 'anthropic'}, id='lc_run--019e0164-d4ed-7330-b40e-78879d50e751', tool_calls=[], invalid_tool_calls=[], tool_call_chunks=[]), {'ls_integration': 'langchain_chat_model', 'lc_agent_name': 'researcher', 'versions': {'deepagents': '0.5.7'}, 'langgraph_step': 2, 'langgraph_node': 'model', 'langgraph_triggers': ('branch:to:model',), 'langgraph_path': ('__pregel_pull', 'model'), 'langgraph_checkpoint_ns': 'tools:8dc57837-ad49-ac67-0914-8c2cccfeddf2|model:3e34c0df-f186-8d4f-51e2-495afe4b1f0d', 'checkpoint_ns': 'tools:3915a820-1ff7-ef6e-f827-4c5120e26f49', 'ls_provider': 'anthropic', 'ls_model_name': 'MiniMax-M2.7', 'ls_model_type': 'chat', 'ls_temperature': None, 'ls_max_tokens': 4096})}

